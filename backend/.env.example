# ---------------------------------------------------------------------------
# Simi backend environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------
# See CODEBASE.md §15 for the full security architecture (3-tier roles per
# cluster, per-tenant owner roles, HMAC-derived passwords, backup strategy).

# --- Runtime ---
NODE_ENV=development
# Host and port the Fastify server binds to.
HOST=0.0.0.0
PORT=3000

# Base domain used to resolve the tenant from the request subdomain.
# In local dev, most OSes resolve <anything>.localhost automatically.
# Examples: simisolutions.localhost  |  app.simisolutions.com
BASE_DOMAIN=simisolutions.localhost

# Whether the apex (base domain itself) is treated as the platform-admin host.
# When true, requests to BASE_DOMAIN (no subdomain) are allowed to reach /admin.
APEX_IS_ADMIN_HOST=true

# Whether to trust X-Forwarded-* headers (Forwarded, X-Forwarded-For,
# X-Forwarded-Host, X-Forwarded-Proto). SECURITY-CRITICAL: tenant resolution,
# rate-limit keying, and session IP attribution all read req.ip / req.hostname.
# Default false — never trust these headers unless you are behind a known proxy.
#
# Accepted values:
#   false                  no trust (default; safe behind nothing / direct exposure)
#   true                   trust all hops (NOT recommended; only for local dev)
#   1                      trust one hop (typical behind a single proxy/ALB)
#   10.0.0.0/8,192.168.0.1 trust only these CIDRs/IPs (recommended in prod)
#
# When enabled, the proxy MUST overwrite (not append to) X-Forwarded-Host and
# X-Forwarded-For.
TRUST_PROXY=false

# Comma-separated list of allowed CORS origins. The frontend must be listed here
# for browser requests to work. In production, set to your actual domain(s).
# Default (http://localhost:5173) is the Vite dev server — MUST override in prod.
# Example: CORS_ORIGINS=https://simisolutions.com,https://*.simisolutions.com
CORS_ORIGINS=http://localhost:5173

# --- JWT / auth ---
# Asymmetric keys (EdDSA / Ed25519). Generate with:
#   openssl genpkey -algorithm Ed25519 -out jwt.private.pem
#   openssl pkey -in jwt.private.pem -pubout -out jwt.public.pem
# Paste as single-line PEM (or load from file in production via a secret manager).
# For local dev you may leave these blank and the app will use a generated
# ephemeral HS256 secret instead — NEVER do that in production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Algorithm used to sign access tokens. EdDSA recommended in production.
JWT_ALGORITHM=HS256
# Issuer / audience stamped into every access token and enforced on verify.
# Binds tokens to this service + audience so they can't be replayed against a
# different service that might share the signing key. Defaults are fine; override
# only if integrating with other services sharing the key.
JWT_ISSUER=simi-backend
JWT_AUDIENCE=simi-api
# Lifetimes (human-readable, parsed by ms-compatible format in code).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Set to true to send refresh tokens only over HTTPS (enable in production).
COOKIE_SECURE=false
# Secret for signing HTTP cookies. Must be ≥32 characters. No default.
# Generate with: openssl rand -base64 32
COOKIE_SECRET=

# --- Global database cluster (auth, users, tenant registry) ---
# 3-tier role model: app (DML), migrate (DDL), admin (superuser).
# See docker/postgres-init-global.sh for what each role can do.
# NOTE: All DB passwords must be ≥16 characters (enforced at startup by Zod).
GLOBAL_DB_HOST=postgres-global
GLOBAL_DB_PORT=5432
GLOBAL_DB_NAME=simi_global
# App role — DML only. Used by runtime pool in src/db/client.ts.
GLOBAL_DB_USER=simi_global_app
GLOBAL_DB_PASSWORD=CHANGE_ME_at_least_16_characters
# Migrate role — DDL only. Used by drizzle-kit and db:migrate:global.
GLOBAL_DB_MIGRATE_USER=simi_global_migrate
GLOBAL_DB_MIGRATE_PASSWORD=CHANGE_ME_at_least_16_characters
# Admin role — superuser (CREATE DATABASE, break-glass). Not used at runtime.
GLOBAL_DB_ADMIN_USER=simi_global_admin
GLOBAL_DB_ADMIN_PASSWORD=CHANGE_ME_at_least_16_characters
# Max connections in the global pool.
GLOBAL_DB_POOL_MAX=10

# --- Tenant database cluster (hosts all per-tenant DBs) ---
# Per-tenant owner + app roles are created dynamically at provisioning.
# See docker/postgres-init-tenant.sh for what the migrate role can do.
TENANT_DB_HOST=postgres-tenant
TENANT_DB_PORT=5432
# Template DB copied via `CREATE DATABASE ... TEMPLATE <this>` at provisioning.
TENANT_DB_TEMPLATE=tenant_template
# Used only by drizzle-kit for introspection during development.
TENANT_DB_NAME=tenant_template
# Migrate role — DDL on template only (for drizzle-kit introspection).
# Actual per-tenant migrations run as each tenant's owner role.
TENANT_DB_MIGRATE_USER=simi_tenant_migrate
TENANT_DB_MIGRATE_PASSWORD=CHANGE_ME_at_least_16_characters
# Admin role — superuser (CREATE DATABASE at provisioning, pg_terminate_backend).
# Not used at runtime.
TENANT_DB_ADMIN_USER=simi_tenant_admin
TENANT_DB_ADMIN_PASSWORD=CHANGE_ME_at_least_16_characters
TENANT_DB_POOL_MAX=10

# --- Per-tenant credential derivation ---
# HMAC-SHA256 master keys used to derive per-tenant role passwords.
# Each tenant DB gets its own owner role (tenant_<subdomain>_owner) and app
# role (tenant_<subdomain>_app), each with a password derived from its
# respective key + tenant ID. See src/lib/tenant-creds.ts.
# Minimum 32 characters. Use different keys per environment.
# Owner key: DDL inside one tenant DB only.
TENANT_OWNER_MASTER_KEY=REPLACE_ME_generate_with_pnpm_generate-secrets
# App key: DML inside one tenant DB only. Separate from owner key so
# compromise of one tier does not expose the other.
TENANT_APP_MASTER_KEY=REPLACE_ME_generate_with_pnpm_generate-secrets

# Use SSL when connecting to managed Postgres (production).
DB_SSL=false

# Default timezone for newly provisioned tenants. IANA name (e.g. Europe/Bucharest).
# Used as fallback when a tenant has not set its own timezone in tenant_settings.
DEFAULT_TENANT_TIMEZONE=UTC

# Passphrase for GPG-encrypting backup files. REQUIRED — the backup containers
# will not start without this. Generate with: openssl rand -base64 24
BACKUP_ENCRYPT_PASSPHRASE=

# --- Observability (file-based logs) ---
# Root directory for per-tenant + global log folders.
LOG_DIR=./logs
# Files older than this many days are purged by the daily cleanup job.
LOG_RETENTION_DAYS=30
# Minimum pino log level (fatal|error|warn|info|debug|trace|silent).
LOG_LEVEL=info

# --- Feature flags ---
# Per-tenant resolved-flag cache TTL in milliseconds.
FLAG_CACHE_TTL_MS=15000

# --- Bootstrap admin (created by `pnpm seed`) ---
SEED_ADMIN_EMAIL=admin@simisolutions.localhost
SEED_ADMIN_PASSWORD=change-me-please
