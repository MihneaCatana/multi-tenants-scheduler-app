{
  "name": "simi-backend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Multi-tenant SaaS backend (global + per-tenant PostgreSQL isolation) for SMB management.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.{ts,json,yml,yaml}\"",
    "db:generate:global": "drizzle-kit generate --config=drizzle.config.global.ts",
    "db:generate:tenant": "drizzle-kit generate --config=drizzle.config.tenant.ts",
    "db:generate": "pnpm db:generate:global && pnpm db:generate:tenant",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:demo": "tsx --env-file=.env src/scripts/seed-demo/index.ts",
    "seed:demo:clinic": "tsx --env-file=.env src/scripts/seed-demo/medical-clinic.ts",
    "seed:demo:salon": "tsx --env-file=.env src/scripts/seed-demo/hairstylist.ts",
    "seed:demo:logistics": "tsx --env-file=.env src/scripts/seed-demo/logistics.ts",
    "setup": "node scripts/dev-setup.mjs",
    "provision:tenant": "tsx --env-file=.env src/scripts/provision-tenant.ts",
    "migrate:app-roles": "tsx --env-file=.env src/scripts/migrate-to-per-tenant-app-roles.ts",
    "generate-secrets": "node scripts/generate-secrets.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "sonic-boom": "^5.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
